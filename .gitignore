# Credentials -- never commit. The development tree kept live Kaggle and
# HuggingFace keys beside the code; these patterns exist so that can never
# reach a remote.
.kaggle/
kaggle*.json
*_key.txt
*token*.txt
.olauth
.env
*.pem

# Data. The raw cohorts are public but not ours to redistribute, and the built
# corpus is large. The frozen folds are the deliberate exception.
#
# Note the trailing `/*`: excluding `data/processed/` itself would make the
# negations below unreachable, because git does not descend into an excluded
# directory. Excluding its *contents* keeps them effective.
data/raw/
data/interim/
data/processed/*
!data/processed/splits_frozen.json
!data/processed/pretrain_holdout.json
*.npz
*.npy

# Training artefacts
artifacts/
kaggle_out/
checkpoints/
*.pt
*.pth
*.ckpt
!weights/**/*.safetensors

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/

# LaTeX
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz

# OS
.DS_Store
Thumbs.db
